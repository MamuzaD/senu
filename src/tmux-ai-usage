#!/usr/bin/env python3
"""Popup summary of Claude Code + Codex usage, reusing tmux-claude-usage /
tmux-codex-usage's own fetch logic via their --json output.

Opens instantly from whatever each script has cached. If a section's data is
older than STALE_NOTICE_SECONDS, shows an aging "refreshing..." note (the
underlying scripts already kick off their own background refresh whenever
they serve stale data) and polls for a newer snapshot, flipping the note to
"now updated" the moment one lands.
"""

import json
import os
import select
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
BAR_WIDTH = 24
LABEL_WIDTH = 8

CODEX_HOME_WORK = str(Path.home() / ".codex-work")

STALE_NOTICE_SECONDS = 10 * 60
POLL_INTERVAL_SECONDS = 1.0
MAX_POLL_SECONDS = 20

ICON_OPENAI = ""  # nerd font cod-openai
ICON_CLAUDE = ""  # nerd font cod-claude

# short bucket labels tmux-codex-usage assigns based on window duration
BUCKET_LABELS = {"S": "Session", "W": "Weekly"}

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
FG_CLAUDE = "\033[38;5;208m"  # orange
FG_CODEX = "\033[38;5;39m"   # blue
FG_GOOD = "\033[38;5;76m"    # green
FG_WARN = "\033[38;5;214m"   # yellow
FG_BAD = "\033[38;5;160m"    # red
FG_DIM = "\033[38;5;240m"    # gray, unknown/n-a
FG_MUTED = "\033[38;5;245m"  # reset-timer text
FG_RULE = "\033[38;5;238m"   # section rule


def color_for(pct):
    if pct is None:
        return FG_DIM
    if pct < 20:
        return FG_BAD
    if pct < 40:
        return FG_WARN
    return FG_GOOD


def fetch_json(script_name, extra_env=None):
    env = {**os.environ, **extra_env} if extra_env else None
    try:
        out = subprocess.run(
            [str(BIN_DIR / script_name), "--json"],
            capture_output=True,
            text=True,
            timeout=10,
            env=env,
        )
        return json.loads(out.stdout)
    except Exception as exc:
        return {"ok": False, "error": str(exc).strip() or "failed to run script"}


def format_duration(seconds):
    if seconds is None:
        return None
    seconds = max(0, int(round(seconds)))
    minutes, _ = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    days, hours = divmod(hours, 24)
    if days > 0:
        return f"{days}d{hours}h" if hours > 0 else f"{days}d"
    if hours > 0:
        return f"{hours}h{minutes}m" if minutes > 0 else f"{hours}h"
    return f"{minutes}m"


def format_resets_at(value):
    if not value:
        return None
    try:
        # Codex gives epoch seconds, Claude gives an ISO timestamp.
        if isinstance(value, (int, float)):
            remaining = value - time.time()
        else:
            from datetime import datetime, timezone

            dt = datetime.fromisoformat(value)
            remaining = (dt - datetime.now(timezone.utc)).total_seconds()
        return format_duration(remaining)
    except Exception:
        return None


def bar(pct):
    if pct is None:
        return "░" * BAR_WIDTH
    pct = max(0, min(100, pct))
    filled = round(pct * BAR_WIDTH / 100)
    return "█" * filled + "░" * (BAR_WIDTH - filled)


def render_row(label, left, resets_at, detail=None):
    reset = format_resets_at(resets_at)
    pct = f"{round(left)}%" if left is not None else "n/a"
    color = color_for(left)
    line = f"    {label:<{LABEL_WIDTH}} {color}{bar(left)}{RESET} {color}{pct:>4}{RESET}"
    if detail:
        line += f"  {detail}"
    if reset:
        line += f"  {FG_MUTED}resets {reset}{RESET}"
    return line


def spend_row(spend):
    if not spend:
        return []
    color = FG_BAD if spend["reached"] else color_for(spend["left"])
    detail = f"{color}${spend['used']:.2f}{RESET}{FG_MUTED}/${spend['limit']:.0f}{RESET}"
    if spend["reached"]:
        detail += f" {FG_BAD}cap reached{RESET}"
    return [render_row("Spend", spend["left"], spend["resets_at"], detail)]


def banked_resets_row(reset_credits):
    if reset_credits is None:
        return []
    label = f"    {'Banked':<{LABEL_WIDTH}} "
    count = reset_credits["available"]
    if count == 0:
        return [f"{label}{FG_DIM}none{RESET}"]
    pips = f"{FG_GOOD}{'●' * count}{RESET}"
    line = f"{label}{pips} {BOLD}{count}{RESET} {FG_MUTED}reset{'s' if count != 1 else ''}{RESET}"
    soonest = min(
        (c["expires_at"] for c in reset_credits["credits"] if c.get("expires_at")),
        default=None,
    )
    if soonest:
        line += f"  {FG_MUTED}expires {format_resets_at(soonest)}{RESET}"
    lines = [line]
    titles = {c["title"] for c in reset_credits["credits"] if c.get("title")}
    for title in sorted(titles):
        lines.append(f"    {' ' * LABEL_WIDTH} {FG_MUTED}{title}{RESET}")
    return lines


def section_header(icon, fg, title):
    heading = f"{icon} {title}"
    rule = "─" * (LABEL_WIDTH + BAR_WIDTH + 8)
    return [f"  {BOLD}{fg}{heading}{RESET}", f"  {FG_RULE}{rule}{RESET}"]


def claude_rows(snapshot):
    if not snapshot.get("ok"):
        return [f"    {FG_BAD}✗ {snapshot.get('error', 'unknown')}{RESET}"]
    return [
        render_row("Session", snapshot.get("five_hour_left"), snapshot.get("five_hour_resets_at")),
        render_row("Week", snapshot.get("seven_day_left"), snapshot.get("seven_day_resets_at")),
    ]


def codex_rows(snapshot):
    if not snapshot.get("ok"):
        return [f"    {FG_BAD}✗ {snapshot.get('error', 'unknown')}{RESET}"]
    rows = [
        render_row(BUCKET_LABELS.get(b["label"], b["label"]), b.get("left"), b.get("resets_at"))
        for b in snapshot.get("buckets") or []
    ]
    rows += spend_row(snapshot.get("spend_limit"))
    rows += banked_resets_row(snapshot.get("reset_credits"))
    return rows


PROFILES = [
    {
        "key": "codex_personal",
        "fetch": ("tmux-codex-usage", None),
        "icon": ICON_OPENAI,
        "fg": FG_CODEX,
        "title": "Codex · personal",
        "rows": codex_rows,
    },
    {
        "key": "codex_work",
        "fetch": ("tmux-codex-usage", {"CODEX_HOME": CODEX_HOME_WORK}),
        "icon": ICON_OPENAI,
        "fg": FG_CODEX,
        "title": "Codex · work",
        "rows": codex_rows,
    },
    {
        "key": "claude_work",
        "fetch": ("tmux-claude-usage", None),
        "icon": ICON_CLAUDE,
        "fg": FG_CLAUDE,
        "title": "Claude · work",
        "rows": claude_rows,
    },
]


def fetch_profile(spec):
    script, env = spec["fetch"]
    return fetch_json(script, env)


def render_section(spec, state, dots):
    snapshot = state["snapshot"]
    title = spec["title"]
    if snapshot.get("plan_type"):
        title += f"{RESET}{FG_MUTED} · {snapshot['plan_type']}"
    lines = section_header(spec["icon"], spec["fg"], title)
    updated_at = snapshot.get("updated_at")
    age = (time.time() - updated_at) if updated_at else None

    if state["just_updated"]:
        lines.append(f"  {FG_GOOD}✓ now updated{RESET}")
    elif state["refreshing"] and age is not None:
        lines.append(f"  {FG_WARN}{format_duration(age)} old · refreshing{dots}{RESET}")
    elif age is not None:
        when = "just now" if age < 60 else f"{format_duration(age)} ago"
        lines.append(f"  {FG_MUTED}✓ updated {when}{RESET}")

    lines.extend(spec["rows"](snapshot))
    return lines


def render_screen(states, dots):
    lines = [""]
    for spec in PROFILES:
        lines.extend(render_section(spec, states[spec["key"]], dots))
        lines.append("")
    lines.append(f"  {DIM}{FG_MUTED}press any key to close{RESET}")
    # joined with \r\n: stdin is put into raw mode (tty.setraw) for the
    # keypress-to-close read, which disables OPOST, so a bare \n no longer
    # implies a carriage return once that's engaged.
    return "\r\n".join(lines)


def initial_state(snapshot):
    updated_at = snapshot.get("updated_at")
    age = (time.time() - updated_at) if updated_at else None
    return {
        "snapshot": snapshot,
        "baseline_updated_at": updated_at,
        "refreshing": age is not None and age > STALE_NOTICE_SECONDS,
        "just_updated": False,
    }


def main():
    with ThreadPoolExecutor(max_workers=len(PROFILES)) as pool:
        futures = {spec["key"]: pool.submit(fetch_profile, spec) for spec in PROFILES}
        states = {key: initial_state(fut.result()) for key, fut in futures.items()}

    def draw(tick):
        dots = "." * ((tick % 3) + 1)
        sys.stdout.write("\033[H\033[J")
        sys.stdout.write(render_screen(states, dots))
        sys.stdout.flush()

    draw(0)

    fd = None
    old_termios = None
    try:
        import termios
        import tty

        fd = sys.stdin.fileno()
        old_termios = termios.tcgetattr(fd)
        tty.setraw(fd)
    except Exception:
        fd = None

    start = time.time()
    tick = 0
    try:
        if fd is None:
            input()
            return 0

        while True:
            elapsed = time.time() - start
            still_watching = elapsed < MAX_POLL_SECONDS and any(
                s["refreshing"] for s in states.values()
            )
            timeout = POLL_INTERVAL_SECONDS if still_watching else None

            ready, _, _ = select.select([fd], [], [], timeout)
            if ready:
                os.read(fd, 1)
                break

            if not still_watching:
                continue

            tick += 1
            for spec in PROFILES:
                state = states[spec["key"]]
                if not state["refreshing"]:
                    continue
                fresh = fetch_profile(spec)
                new_updated_at = fresh.get("updated_at")
                if new_updated_at and (
                    state["baseline_updated_at"] is None
                    or new_updated_at > state["baseline_updated_at"]
                ):
                    state["snapshot"] = fresh
                    state["refreshing"] = False
                    state["just_updated"] = True
                elif time.time() - start >= MAX_POLL_SECONDS:
                    state["refreshing"] = False
            draw(tick)
    finally:
        if fd is not None and old_termios is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_termios)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
